    //API Functions

    //Send User a list of products
    public function getProducts(request $request){

        //I do not believe there is a french description for the products. 
        //The client API request will need to send in a token whether or not they want the French descriptions or English.

        $limit = $request->input('limit');
        $filter = $request->input('filter');
        $category = $request->input('category');

        //If user has specified a category:
        if(strlen($category)){
                //If user has specified a search and category
            if(strlen($filter)){
                $products = Products::select()->where('active', 1)->where('category_id', $category)->where(function($query) use ($filter){
                    // $query->where('sku', 'like', '%'.$filter.'%')->orWhere('mmm_id', 'like', '%'.$filter.'%')->orWhere('description', 'like', '%'.$filter.'%');
                    $query->where('sku', 'like', '%'.$filter.'%')->orWhere('description_fr', 'like', '%'.$filter.'%')->orWhere('description', 'like', '%'.$filter.'%');
                })->with('attached_category')->paginate($limit);
            } else{
                //If user specified category but no search filter
                $products = Products::select()->where('active', 1)->where('category_id', $category)->with('attached_category')->paginate($limit);
            }
        } else {
            if(strlen($filter)){
                //User has specified a search filter but no specific category
                // $products = Products::select()->where('sku', 'like', '%'.$filter.'%')->orWhere('mmm_id', 'like', '%'.$filter.'%')->orWhere('description', 'like', '%'.$filter.'%')->with('attached_category')->paginate($limit);
                $products = Products::select()->where('active', 1)->where('sku', 'like', '%'.$filter.'%')->orWhere('description_fr', 'like', '%'.$filter.'%')->orWhere('description', 'like', '%'.$filter.'%')->with('attached_category')->paginate($limit);
            } else {
                //User has specified nothing, initial base load
                $products = Products::select()->where('active', 1)->with('attached_category')->paginate($limit);
            }

        }
        $categories = ProductCategories::select()->get()->toArray();
        $returned_data = json_encode(array(
            'categories' => $categories,
            'products' => $products
        ));
        return $returned_data;
    }

    public function getCustomersRebate(Request $request){
        //Need authentication to identify what user this is. 
        //For now we will use filler.
        $uid = Auth::id();
        $submissions = Submissions::select()->where('customer_id', $uid)->with('author')->with('submission_status')->orderBy('created_at', 'DESC')->paginate(20);
        return $submissions;
    }


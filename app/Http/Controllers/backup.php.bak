    public function getSubmissionApi($id){
        //Need authentication to identify what user this is. 
        //For now we will use filler.
        $trySubmission = Submissions::select('customer_id')->where('id', $id)->first();
        $sid = $trySubmission->customer_id;
        if($sid !== Auth::user()->id) {
            return response("Submission does not belong to this customer.", 403);
        } 
        if(Auth::user()){
            $user = Auth::user();
        } else {
            $user = User::select()->where('id', 5)->first(); 
        }
        $userRole = "Customer";
        $payment= PaymentSection::select()->where('submission_id', $id)->first();
        if(!$payment){
            $payid = "none";
        } else {
            $payid = $payment->id;
        }
        $statuses = Statuses::select('id','status')->get();
        $submission = $this->getSubmissionData($id);

        $history = $submission->history_stages;
        $reasons = Reasons::select('id', 'reason')->get();
        return $submission;
    }


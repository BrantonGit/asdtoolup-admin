    //Admin uses this function to submit their review of the submission
    //This function will simply change the status/comments/reasons of the current sections to the submission.
    //This WILL NOT create any new sections
    public function reviewSubmission(Request $request, $id){
        
        $submission = $this->getSubmissionData($id);
        $subid = $submission->id;
        $author = User::select()->where('id', $submission->customer_id)->first();

        $user = Auth::user();
        if(!$this->isClosed($id)){

            //Define the current sections attached to this submission
            $customerInfoSection = CustomerInfoSections::select()->where('id', $submission->customerinfo_section_id)->first();
            $tradeInSection = TradedinSections::select()->where('id', $submission->tradedin_section_id)->first();
            $tradeUpSection = TradedupSections::select()->where('id', $submission->tradedup_section_id)->first();
            $receiptSection = ReceiptSections::select()->where('id', $submission->receipts_section_id)->first();
        
            //Update Customer Info Review
            $customerInfoSection->update([
                'status' => $request->input('customerinfoStatus'),
                'comments' => $request->input('customerinfoComment'),
                'reason_id' => $request->input('customerinfoReason')
            ]);

        $customerInfoSection->save();

        //Update Trade In Review
        $tradeInSection->update([
            'status' => $request->input('tradeinsStatus'),
            'comments' => $request->input('tradeinsComment'),
            'reason_id' => $request->input('tradeinsReason')
        ]);
        $tradeInSection->save();

        //Update Tool Up Review
        $tradeUpSection->update([
            'status' => $request->input('tradeupsStatus'),
            'comments' => $request->input('tradeupsComment'),
            'reason_id' => $request->input('tradeupsReason')
        ]);
        $tradeUpSection->save();
            
        //Update Receipt Info
        $receiptSection->update([
            'status' => $request->input('receiptStatus'),
            'comments' =>  $request->input('receiptComment'),
            'reason_id' => $request->input('receiptReason')
        ]);
        
        $tradeUpSection->save();
        $history = $this->historyFullSubmission($submission, "Reviewed submission", "Demande examinée");

        // return $history;
        //Compile all four sections' status. We will then check the array to see if all are approved or what statuses are prominent.
        $submissionStatusCheck = array($customerInfoSection->status, $tradeUpSection->status, $tradeInSection->status,$receiptSection->status);
        $submissionStatus = $this->checkSubmissionSections($submissionStatusCheck);

        $duplicatepayment = PaymentSection::where('submission_id', $submission->id)->first();
        if(empty($duplicatepayment)){

        if($submissionStatus === 4){
            $makePayment = $this->makePaymentSection($submission);
            $subjectPay = "Rebate Ready for Payment";
            $mesPay = "A rebate is ready for payment.";
          //  Mail::to('rodney@branton.ca')->send(new RebateUpdatePayment($subjectPay, $mesPay, $subid, 'Rodney', "en"));
           // Mail::to('curtis@branton.ca')->send(new RebateUpdatePayment($subjectPay, $mesPay, $subid, 'Curtis', "en"));
        }
            $submission->update(['status'=>$submissionStatus]);
            $submission->save();
            $mes = "Your rebate has been reviewed!";
            $subject = "Rebate Reviewed";


            //We will need to push a language element into the submission to refer to...
            if(!$author->notifications == 0){
          //   Mail::to($author)->send(new RebateUpdate($subject, $mes, $subid, $author, "en"));
            }
         }
     
            return redirect('/submissions/' . $submission->id);
        }


        return;
    }
    protected function makePaymentSection($submission, $value){
        $sid = $submission->id;
        if(!$this->isClosed($sid)){
        $paymentSection = new PaymentSection([
            "submission_id" => $sid,
            "payment_amount_cad" => $value//This will eventually have to be added
        ]);
        $paymentSection->save();
        return $paymentSection;
        };
        return;
    }




    //===================================================================
    //PROTECTED FUNCTIONS
    //These functions are meant to be inherited by their extended classes.
    //===================================================================

    protected function historyFullSubmission($submission, $message, $messagefr) {
        

        //***REMOVE THIS ONCE API AUTH IS ADDED
        if(Auth::user()){
            $user = Auth::user();
        } else{
            $user = User::select()->where('id', 5)->first();
        }
        // $user = User::select()->where('id', 3)->first();
        $check = HistoryStageSubmission::select()->where([
            ['author_id', '=', $user->id],
            ['customerinfo_section_id', '=', $submission->customerInfo->id],
            ['receipt_section_id', '=', $submission->receipts->id]
        ])->first();
            if($check !== null){
                return;
            } else {
           
        $historySection = new HistoryStageSubmission([
            'author_id' => $user->id,
            'history_stages_submission_id' => $submission->history_stages_id,
            'customerinfo_section_id' => $submission->customerInfo->id,
            'receipt_section_id' => $submission->receipts->id,
            'message' => $message,
            'messagefr' => $messagefr
        ]);
        $historySection->save();
        return $historySection;
    }
    }

    //Returns a new section for the created submission
    protected function customerInfo($req, $container){
        // return $req['fname'];]

        if(!$this->isClosed($container->id)){
        $customerInfo = new CustomerInfoSections([
            "submission_id" => $container->id,
            "status" => 1,
            "fname" => $req->input('customerInfo.fname'),
            "lname" => $req->input('customerInfo.lname'),
            "phone" => $req->input('customerInfo.phone'),
            "email" => $req->input('customerInfo.email'),
            "company" => $req->input('customerInfo.company'),
            "profession" => $req->input('customerInfo.profession'),
            "address" => $req->input('customerInfo.address'),
            "city" => $req->input('customerInfo.city'),
            "country" => $req->input('customerInfo.country'),
            "postal" => $req->input('customerInfo.postal'),
            "chequeissue"  => $req->input('customerInfo.chequeissue')
        ]);
        $customerInfo->save();
        // return $customerInfo;
        return $customerInfo->id;
        };
        return;
    }

    //Returns a new section for the created submission
    protected function receiptInfo($req, $container){
        if(!$this->isClosed($container->id)){
            // if(strlen(trim($req->input('customerInfo.vendor'))) > 0){
            //     $vendor = $req->input('customerInfo.vendor');
            // } else {
            //     $vendor = $req->vendor;
            // }
        $receiptSection = new ReceiptSections([
            'submission_id' => $container->id,
            'status' => 1,
            // 'vendor' => $vendor
        ]);
        $receiptSection->save();
        $files = $req->file('receipt');

        // I need to see if there is any files.
        // If not, it is assumed this is an edit not a submission, since it is mandatory for a submission.
        // We then want to find current submission's receipt section ID and find all associated photos with it.
        // Replicate those entries and change its section ID to its new one, $receiptSection->id;
        if(!$req->file('receipt')){
            //Get all of the old photos, create a new ReceiptSectionSubmission for each of the old photos with the new receiptSection ($receiptSection)
            $oldPhotos = ReceiptSectionSubmission::select('photo')->where('receipt_section_id', $container->receipts_section_id)->get();
            foreach($oldPhotos as $oldPhoto) {
                $receiptSubmission = new ReceiptSectionSubmission([
                    "receipt_section_id" => $receiptSection->id,
                    "photo" => $oldPhoto->photo
                ]);
                $receiptSubmission->save();
            }
         } else { 
            foreach($files as $file) {
                $filename = $this->imageUpload($file);
                $receiptSubmission = new ReceiptSectionSubmission([
                    "receipt_section_id" => $receiptSection->id,
                    "photo" => $filename[0],
                    "kind" => $filename[1]
                ]);
                $receiptSubmission->save();
            }
        }
        //Original Receipt Products, has been switched to TradeIn
        // $receiptProducts = $req->input('receiptProducts');
        // foreach($receiptProducts as $receiptProd){
        //     //Make new receiptProduct
        //     $receiptRow = new ReceiptProducts([
        //         "receipt_section_id" => $receiptSection->id,
        //         "product_number" => $receiptProd['product_number'],
        //         "product_qty" => $receiptProd['product_qty']
        //     ]);
        //     $receiptRow->save();
        // };
        
        return $receiptSection->id;
        }
        return;
    }

    //Returns a new section for the created submission
    protected function tradedinInfo($req, $container){
        if(!$this->isClosed($container->id)){
            if(strlen(trim($req->input('customerInfo.vendor'))) > 0){
                $vendor = $req->input('customerInfo.vendor');
            } else {
                $vendor = $req->vendor;
            }
        $tradedinSection = new TradedinSections([
            'submission_id' => $container->id,
            'status' => 1,
            'vendor' => $vendor
        ]);
        $tradedinSection->save();


        //OLD FILE UPLOAD WHEN THIS SECTION ONLY HAD PHOTO UPLOADING
        // $files = $req->file('tradein');
        // foreach($files as $file) {
        //     $filename = $this->imageUpload($file);
        //     $tradedinSubmission = new TradedinSectionSubmission([
        //         "tradedin_section_id" => $tradedinSection->id,
        //         "photo" => $filename
        //     ]);
        //     $tradedinSubmission->save();
        // }



        $getfolder = CustomerInfoSections::where('submission_id', $container->id)->first();

        $receiptfiles = FileUpload::where('folder', $getfolder->email)->where('size', 'new')->where('intake', 'receipt')->get();
        $tradeinfiles = FileUpload::where('folder', $getfolder->email)->where('size', 'new')->where('intake', 'tradein')->get();
    
        $oldfilePath = 'uploads/'. $getfolder->email . '/new/';

        $newfilePath = 'uploads/'. $getfolder->email . '/' . $container->id . '/';

        $s3 = Storage::disk('local');
        $receipts = Storage::disk('local')->allFiles($oldfilePath . 'receipt/');
        $tradeins = Storage::disk('local')->allFiles($oldfilePath  . 'tradein/');

        foreach($receipts as $receipt) {
            $new_loc = str_replace($oldfilePath . 'receipt/', $newfilePath . 'receipt/', $receipt);
            $s3->copy($receipt, $new_loc);
            $s3->delete($oldfilePath . 'receipt/', $receipt);
        }

        foreach($tradeins as $tradein) {
            $new_loc = str_replace($oldfilePath . 'tradein/', $newfilePath . 'tradein/', $tradein);
            $s3->copy($tradein, $new_loc);
            $s3->delete($oldfilePath . 'tradein/', $tradein);
        }
        
        // // Storage::disk('local')->deleteDirectory($oldfilePath);

        foreach($receiptfiles as $file){
            $file->confirmid = $container->id; 
            $file->projectid = $container->id;
            $file->size = 'inuse';
            $file->userid = $container->customer_id;
            $file->save();      
        }

        foreach($tradeinfiles as $file){
            $file->confirmid = $container->id; 
            $file->projectid = $container->id;
            $file->size = 'inuse';
            $file->userid = $container->customer_id;
            $file->save();      
        }

        // return 'good';

        $files = $req->file('tradein');
        if(!$req->file('tradein')){
            //Get all of the old photos, create a new ReceiptSectionSubmission for each of the old photos with the new receiptSection ($receiptSection)
            $oldPhotos = TradedinSectionSubmission::select('photo')->where('tradedin_section_id', $container->tradedin_section_id)->get();
            foreach($oldPhotos as $oldPhoto) {
                $tradedinSubmission = new TradedinSectionSubmission([
                    "tradedin_section_id" => $tradedinSection->id,
                    "photo" => $oldPhoto->photo
                ]);
                $tradedinSubmission->save();
            }
         } else { 
            foreach($files as $file) {
                $filename = $this->imageUpload($file);
                $tradedinSubmission = new TradedinSectionSubmission([
                    "tradedin_section_id" => $tradedinSection->id,
                    "photo" => $filename[0]
                ]);
                $tradedinSubmission->save();
            }
        }



        //This creates the brands
        // $brandSection = $this->createBrand($req->brands, $tradedinSection->id);

        $tradeinProducts = $req->input('tradeinProducts');
        foreach($tradeinProducts as $tradeProd){
            //Make new receiptProduct


            if(!$tradeProd['product_qty']){
              $tradeProd['product_qty'] = 'N/A';
            }

            if(!$tradeProd['brand']){
                $tradeProd['brand'] = 'N/A';
              }

            if(!$tradeProd['product_number']){
                $tradeProd['product_number'] = 'N/A';
              }

            $receiptRow = new TradeInProducts([
                "tradedin_section_id" => $tradedinSection->id,
                "product_number" => $tradeProd['product_number'],
                "product_qty" => $tradeProd['product_qty'],
                "brand" => $tradeProd['brand']
            ]);
            $receiptRow->save();
        };
        return $tradedinSection->id;
        }
        return;
    }

    protected function createBrand($selectedBrands, $idSection){
        $brand = new BrandSections([
            "tradedin_section_id" => $idSection
        ]);
        $brand->save();
        $id = $brand->id;
        
        foreach ($selectedBrands as $br){
            $brandSubmission = new BrandSectionSubmission([
                "brand_id" => $br,
                "brand_tradedin_section_id" => $id
            ]);
            $brandSubmission->save();
        }
        return $id;
        
    }


    //Returns a new section for the created submission
    protected function tradedupInfo($req, $container){
        if(!$this->isClosed($container->id)){
        $tradedupSection = new TradedupSections([
            'submission_id' => $container->id,
            'status' => 1
        ]);
        $tradedupSection->save();

        $products = $req->input('tradeup');
        // return $products;
        foreach ($products as $product){
            //Server side is prodid
            // $json = json_encode($product);
            if(is_string($product)){
                $product = json_decode($product, true);
            }
            
            // return $prod["id"];
            // return gettype($prod);
            $selectedProd = Products::select()->where('id', $product['id'])->first();
            //Take the rebate value defined in the product, and multiple it by the quantity the user submitted
            $amount = $selectedProd['rebate_value'] * intval($product["quantity"]);
            $tradedupSubmission = new TradedupSectionSubmission([
                "tradedup_section_id" => $tradedupSection->id,
                "product_id" => $product["id"],
                "quantity" => intval($product["quantity"]),
                "value" => $amount,
                "init_value" => $product["details"]["rebate_value"]
            ]);
            $tradedupSubmission->save();
        }
        return $tradedupSection->id;
    }
        return;
    }

    protected function checkSubmissionSections($arr){
        //This is given an array of all 4 sections' status. If all are equal to 4 (Approved), return 4.
        //Otherwise, if a single declined is in the submission, change submission status to declined.

        //1 - Pending
        //2 - Needs Info
        //3 - Declined
        //4 - Approved

        $status = 1; //Pending
            //This just checks the array to see if all are equal to 4
        if(count(array_keys($arr, 4)) == count($arr)){
            $status = 4; //Approved
        } 
        else if(in_array(3, $arr)){
            //This takes priority over Needs Info. 
            //If even one section is declined, then the whole submission is declined.
            $status = 3; // Declined
        }
        else if(in_array(2, $arr)){
            $status = 2; //Needs Info
        } 
        return $status;
    }
    
    protected function closeSubmission($id){
        //With active submissions, we still want them to be viewable 
        //but we want to remove any editing/updating functionality once closed.
        //This changes the submission's active status to 0.
        $submission = Submissions::select()->where('id', $id)->first();
        $submission->update([
            'active' => 0
        ]);
        $submission->save();
        return $submission;
    }
    protected function isClosed($id){
        //Just a simple check to see if the submission is closed. 
        //It should be closed if the status is 3/Declined or the active status is set to 0.
        //Use this function to validate before any update/edit to a submission from either customer or admin.
        $closed = false;
        $submission = Submissions::select()->where('id', $id)->first();
        if($submission->active == 0 || $submission->status == 3){
            //Might have a second if statement to check if user is master.
            if($submission->status == 4 || Auth::User()->role == 2){
                return $closed;
            }
            $closed = true;
            abort(403, 'Submission is closed.');
        } 
        return $closed;
        
    }

    //Check if this submission belong to this user ID
    protected function appliesTo($sid){
        //Use this function for authentication purposes
        $uid = Auth::User()->id;
        $s = Submissions::select('customer_id')->where('id', $sid)->first();
        $belongsTo = false;
        if($uid == $s->customer_id){
            $belongsTo = true;
            return $belongsTo;
        } else {
            abort(403, "Submission does not belong to you.");
        }
    }

    //Call this function every time you wish to upload a submission image
    protected function imageUpload($file){        

        $ext = $file->getClientOriginalExtension();
        $filename = date('mdys').rand(1, 1000).".".$ext;

                if($file->extension() === 'pdf'){    
                    $filePath = base_path('/uploads');
                    $file->move($filePath, $filename);
                    $kind= 'pdf';
                } else {

        $img = Image::make($file);
        $height = $img->height();
        $width = $img->width();
        if($width >= $height) {
            // Landscape image
            // If image width is smaller than 1000px, do not resize.
            if($width >= 1000){
                $img->resize(null, 1000, function ($constraint) {
                    $constraint->aspectRatio();
                })->save(
                    // public_path('//uploads/lrg-'.$filename )
                    base_path('/uploads/lrg-'.$filename )
                );
            } else {
                $img->save(
                    // public_path('//uploads/lrg-'.$filename )
                    base_path('/uploads/lrg-'.$filename )
                );
            }

            //Make thumbnail for landscape image
            $img->resize(null, 200, function ($constraint) {
                $constraint->aspectRatio();
            })->save(
                    // public_path('//uploads/'.$filename )
                    base_path('/uploads/'.$filename )
            );

        } else {
            // Portrait image
            // If image height is smaller than 1000px, do not resize.
            if($height >= 1000){
                $img->resize(1000, null, function ($constraint) {
                    $constraint->aspectRatio();
                })->save(
                    // public_path('//uploads/lrg-'.$filename )
                    base_path('/uploads/lrg-'.$filename )
            );
            } else {
                $img->save(
                    // public_path('//uploads/lrg-'.$filename )
                    base_path('/uploads/lrg-'.$filename )
            );
            }

            //Make thumbnail for portrait image
            $img->resize(200, null, function ($constraint) {
                $constraint->aspectRatio();
            })->save(
                    // public_path('//uploads/'.$filename )
                    base_path('/uploads/'.$filename )
            );
        }

        $kind= 'img';
       

    }
        //Return filename to inject into SQL entry
        return array($filename, $kind);
    }

    protected function resetSubmissionStatus($submission){
        if(!$this->isClosed($submission->id)){
            $submission->update([
                'status' => 1
            ]);
            $submission->save();
        }
        return $submission->status;
    }
}






